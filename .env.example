# StayBook environment configuration
# Every variable is optional — the app runs with zero configuration because the
# backend lives entirely in the browser (IndexedDB + an in-browser mock API).
# Copy this file to .env.local and adjust as needed.

# Canonical site URL used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Simulated network latency for the mock API, as a "min-max" millisecond range.
NEXT_PUBLIC_MOCK_LATENCY_MS=200-600

# Fraction (0–1) of mock requests that randomly fail, to exercise error states.
NEXT_PUBLIC_MOCK_ERROR_RATE=0.03
